# CoinGecko API 配置
coingecko:
  api_key: "your_coingecko_api_key_here"

# Alpaca 美股行情配置（仅在 stocks 非空时必填）
# delayed_sip 表示报告使用至少延迟 15 分钟的 SIP 综合行情。
alpaca:
  api_key: "your_alpaca_api_key_here"
  secret_key: "your_alpaca_secret_key_here"
  feed: "delayed_sip"

# Hyperliquid 使用公开 Info API，不需要钱包、私钥或 API key。
hyperliquid:
  perpetuals:
    - "xyz:ZHIPU"

# 邮件配置（可选，如果配置了 Discord 则非必需）
email:
  smtp_server: "smtp.gmail.com"
  smtp_port: 587
  username: "your_email@gmail.com"
  password: "your_app_password"
  to:
    - "recipient@example.com"

# Discord 配置（可选，如果配置了邮件则非必需）
# 至少需要配置邮件或 Discord 其中一个通知渠道
discord:
  bot_token: "your_discord_bot_token_here"
  channel_id: "your_channel_id_here"

# 代理配置（可选）
proxy:
  enabled: false
  url: "http://127.0.0.1:8080"

# 要跟踪的加密货币 (使用 CoinGecko ID)
coins:
  - "bitcoin"
  - "ethereum"
  - "cardano"
  - "polkadot"
  - "chainlink"
  - "virtual-protocol"
  - "near"

# 要跟踪的美国上市股票或 ETF 代码
stocks:
  - "QQQ"
  - "SPCX"

# 定时发送时间
schedule:
  hour: 9    # 24小时制
  minute: 0
